;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/math-camera.gc")
(require "engine/geometry/geometry.gc")
(require "engine/camera/cam-interface-h.gc")
(require "engine/camera/cam-interface.gc")
(require "engine/target/target-h.gc")
(require "engine/target/target-handler.gc")
(require "engine/ps2/pad.gc")
(require "engine/common-obs/water.gc")
(require "engine/common-obs/nav-enemy.gc")
(require "engine/common-obs/crates.gc")
(require "engine/common-obs/baseplat.gc")
(require "engine/common-obs/basebutton.gc")

;; Minecraft passthrough mod (JakCraft): Minecraft on top of Jak and Daxter.
;;
;; You play Minecraft, in the Minecraft window. Jak and Daxter is only the world you play in:
;;  - The companion Fabric mod sends Steve's eye position, yaw, pitch and FOV every frame over
;;    localhost UDP (game/mods/mc_passthrough.cpp keeps the newest packet).
;;  - Jak's camera is put at Steve's eyes and the finished frame is handed to Minecraft
;;    (game/mods/mc_frame_share.cpp), which draws it in place of its sky. Minecraft also has Jak's
;;    level shape, so its blocks hide behind Jak's walls and Steve walks on Jak's ground with
;;    Minecraft's own physics (Jak's collision became invisible barrier blocks).
;;  - Jak and Daxter are gone: hidden, his controller is cut off and he is dragged along under
;;    Steve's feet, so levels and enemies keep loading around you and Jak's world reacts to Steve
;;    (pickups, power cells, scout flies, eco vents, buttons, doors). Whatever Steve's body touches
;;    is picked up, also in third person. Damage to Jak goes to Steve (Minecraft health, knockback).
;;    When the game itself takes Jak somewhere (warp gate, cutscene, checkpoint, launcher), Steve is
;;    sent after him. A few Minecraft keys are Jak's buttons (talk to people, warp gates).
;;  - Cutscenes play with Jak's own camera and Minecraft shows them full screen.
;;  - Blocks Steve places are sent back (BLOCKS packet): Jak's enemies have to walk around them,
;;    and lava / fire / magma / cactus kill enemies that walk into them. Steve's punches (aimed
;;    where Steve looks, also in third person) kill any enemy, break crates (scout fly boxes too) and
;;    press buttons; Minecraft explosions (TNT, creepers) kill enemies and break every crate.
;;  - Every frame is tagged with the Minecraft camera pose it was drawn from (pc-mc-pose-used), so
;;    Minecraft can draw its own world from the same pose and the two pictures never drift apart.
;;
;; Coordinates: Minecraft sends Jak meters (1 block = 1 meter, same axes, +Y up). Jak: 1 meter =
;; 4096 units. Minecraft yaw 0 faces +Z and turns towards -X, so Jak heading = -yaw.
;;
;; REPL helpers: (mc-on) (mc-off) (mc-reanchor) (mc-status) (mc-debug #t/#f)

(define-extern pc-mc-get-camera (function (pointer float) int))
(define-extern pc-mc-send-state (function (pointer float) int))
(define-extern pc-mc-pop-event (function (pointer float) int))
(define-extern pc-mc-get-blocks (function pointer int int))
(define-extern pc-mc-pose-used (function int))
(define-extern pc-mc-send-actors (function pointer int int))
(define-extern pc-mc-send-light (function pointer int))

(defconstant MC_RAW_X 0)
(defconstant MC_RAW_Y 1)
(defconstant MC_RAW_Z 2)
(defconstant MC_RAW_YAW 3)
(defconstant MC_RAW_PITCH 4)
(defconstant MC_RAW_VFOV 5)
(defconstant MC_RAW_AGE_MS 6)
(defconstant MC_RAW_SEQ 7)
(defconstant MC_RAW_FLAGS 8)
(defconstant MC_RAW_EYE_HEIGHT 9) ;; Steve's eye height above his feet (m), he can be scaled up
(defconstant MC_RAW_FEET_X 12)    ;; Steve's feet (Jak meters): not under the camera in third person
(defconstant MC_RAW_FEET_Y 13)
(defconstant MC_RAW_FEET_Z 14)
(defconstant MC_RAW_HAS_FEET 15)
(defconstant MC_RAW_LOOK_YAW 16)   ;; where Steve himself looks: the camera looks at him in front view
(defconstant MC_RAW_LOOK_PITCH 17)
(defconstant MC_RAW_HAS_LOOK 18)
(defconstant MC_RAW_BUTTONS 11)

;; CAMERA packet flags (see PROTOCOL.md)
(defconstant MC_FLAG_STEVE_MODE 8)
(defconstant MC_FLAG_IN_HOLE 16) ;; Steve is down a hole he dug into Jak's ground
(defconstant MC_FLAG_PAUSED 32)  ;; Minecraft's game menu is open: singleplayer Minecraft is paused
(defconstant MC_FLAG_JAK_PUNCH 64) ;; Steve's left click also makes (the hidden) Jak punch, from Steve's feet

;; CAMERA packet buttons
(defconstant MC_BUTTON_ATTACK 8)
;; Minecraft keys that are Jak's buttons (see JakBridgeClient): circle, X, triangle, d-pad
(defconstant MC_BUTTON_JAK_CIRCLE 32)
(defconstant MC_BUTTON_JAK_X 64)
(defconstant MC_BUTTON_JAK_TRIANGLE 128)
(defconstant MC_BUTTON_JAK_LEFT 256)
(defconstant MC_BUTTON_JAK_RIGHT 512)
(defconstant MC_BUTTON_JAK_UP 1024)
(defconstant MC_BUTTON_JAK_DOWN 2048)

;; Minecraft -> Jak events (pc-mc-pop-event)
(defconstant MC_EVENT_EXPLOSION 1)

;; "no water here" in JAK_STATE data[7]
(defconstant MC_NO_WATER -100000.0)

;; JAK_STATE flags
(defconstant JAK_STATE_FLAG_STEVE 2)
(defconstant JAK_STATE_FLAG_CUTSCENE 4) ;; Jak's own camera: Minecraft shows the picture full screen
(defconstant MC_STATE_FLOATS 22)        ;; JAK_STATE payload size (see PROTOCOL.md)

;; what Steve's last left click did (JAK_STATE data[15], shown by /jakcraft in Minecraft)
(defconstant MC_PUNCH_NONE 0)
(defconstant MC_PUNCH_HIT 1)        ;; killed an enemy / broke a crate / pressed a button
(defconstant MC_PUNCH_NO_EFFECT 2)  ;; hit an enemy that ignored every kind of attack
(defconstant MC_PUNCH_MISSED 3)     ;; nothing Steve can hit within reach where he looks

(deftype mc-passthrough-state (structure)
  ((enabled?     symbol)    ;; master switch
   (mode         symbol)    ;; 'steve while Minecraft is playing, #f otherwise
   (match-fov?   symbol)    ;; copy Minecraft's FOV (required so the pictures line up)
   (debug?       symbol)    ;; print status to the screen
   (timeout-ms   float)     ;; packets older than this hand everything back to Jak
   (scale        float)     ;; jak units per Minecraft block
   (eye-height   float)     ;; Steve's eye height above his feet (jak units)
   (activations  int32)
   (parked?      symbol)    ;; Jak is being dragged along under Steve's feet
   (handovers    int32)     ;; times the game moved Jak somewhere and Steve was sent after him
   (handover-time time-frame) ;; when Steve was last asked to go to the spawn point
   (steve-damage float)     ;; total Minecraft health points of damage dealt to Steve
   (hits         int32)     ;; times Jak's world hurt Steve
   (kills        int32)     ;; Jak enemies Steve killed
   (last-hit-time time-frame)
   (last-attack-time time-frame)
   (prev-buttons int32)
   (melee-reach  float)     ;; how far Steve's punch reaches (jak units)
   (aspect-saved? symbol)   ;; Jak's aspect settings were changed to match Minecraft
   (paused-jak?  symbol)    ;; Jak is paused because Minecraft is
   (saved-aspect-auto? symbol)
   (saved-use-vis? symbol)
   (saved-aspect-x int32)
   (saved-aspect-y int32)
   (punches      int32)     ;; Steve's left clicks in Jak's world
   (punch-result int32)     ;; MC_PUNCH_*: what the last one did
   (pad-prev-buttons int32) ;; Minecraft buttons last frame, as seen by the controller hook
   (jak-gap      float)     ;; how far Jak was from Steve's feet before he was put back (m)
   (stream-want  int32)     ;; level-load-info index of the level streamed around Steve (0 = none)
   (event        float 5)
   (raw          float 20)  ;; latest packet, see pc-mc-get-camera in mc_passthrough.h
   (out          float 22)  ;; JAK_STATE payload (MC_STATE_FLOATS)
   (spawn        vector :inline) ;; where Minecraft must put Steve (jak units, feet)
   (last-park    vector :inline) ;; where we left Jak last frame
   (pos          vector :inline) ;; the camera (Minecraft's, also in third person)
   (feet         vector :inline) ;; Steve's feet
   (eye          vector :inline) ;; Steve's eyes
   (fwd          vector :inline) ;; where the camera looks
   (aim          vector :inline) ;; where Steve looks (his punches go there)
   (hit-from     vector :inline) ;; where the last thing that hurt Steve was (w = 0: nowhere)
   (jak          process)   ;; the Jak we took over (a warp gate or a new game makes a new one)
   (in-movie?    symbol)))

(define *mc-passthrough*
  (new 'static
       'mc-passthrough-state
       :enabled? #t
       :mode #f
       :match-fov? #t
       :debug? #f
       :timeout-ms 1500.0 ;; Minecraft hitches (saving, loading chunks) must not hand Jak back
       :scale (meters 1.0)
       :eye-height (meters 1.62)
       :melee-reach (meters 4.5)))

(define-extern mc-unpause! (function mc-passthrough-state none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; helpers
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun mc-packet-fresh? ((st mc-passthrough-state))
  "Read the newest packet into (-> st raw). #t if Minecraft is connected right now."
  (and (nonzero? (pc-mc-get-camera (&-> st raw 0))) (< (-> st raw MC_RAW_AGE_MS) (-> st timeout-ms))))

(defun mc-packet-flag? ((st mc-passthrough-state) (flag int))
  (logtest? (the int (-> st raw MC_RAW_FLAGS)) flag))

(defun mc-set-jak-hidden! ((hidden symbol))
  "Hide or show Jak and Daxter. This only stops them from being drawn (skip-bones): the real
   'hidden' flag is part of the game's own logic (a warp gate waits for Jak to become hidden at
   the end of his jump into it before it loads the next level), so it is left alone."
  (when *target*
    (if hidden
      (logior! (-> *target* draw status) (draw-status skip-bones))
      (logclear! (-> *target* draw status) (draw-status skip-bones))))
  (when *sidekick*
    (if hidden
      (logior! (-> *sidekick* draw status) (draw-status skip-bones))
      (logclear! (-> *sidekick* draw status) (draw-status skip-bones))))
  (none))

(defun mc-restore-aspect! ((st mc-passthrough-state))
  "Put Jak's aspect ratio settings back the way they were before Minecraft took over."
  (when (-> st aspect-saved?)
    (cond
      ((-> st saved-aspect-auto?) (set! (-> *pc-settings* aspect-ratio-auto?) #t))
      (else (set-aspect! *pc-settings* (-> st saved-aspect-x) (-> st saved-aspect-y))))
    (set! (-> *pc-settings* use-vis?) (-> st saved-use-vis?))
    (set! (-> st aspect-saved?) #f))
  (none))

(defun mc-sync-aspect! ((st mc-passthrough-state))
  "Render Jak's frame with the same shape as the Minecraft window, so the two line up.
   Minecraft sends width/height * 1000 in the top 16 bits of the CAMERA flags."
  (let ((mc-aspect-1000 (shr (the int (-> st raw MC_RAW_FLAGS)) 16)))
    (when (and (< 500 mc-aspect-1000) (< mc-aspect-1000 5000))
      (let ((want (* 0.001 (the float mc-aspect-1000))))
        (when (or (not (-> st aspect-saved?)) (< 0.005 (fabs (- want (-> *pc-settings* aspect-ratio)))))
          (when (not (-> st aspect-saved?))
            (set! (-> st saved-aspect-auto?) (-> *pc-settings* aspect-ratio-auto?))
            (set! (-> st saved-use-vis?) (-> *pc-settings* use-vis?))
            (set! (-> st saved-aspect-x) (-> *pc-settings* aspect-custom-x))
            (set! (-> st saved-aspect-y) (-> *pc-settings* aspect-custom-y))
            (set! (-> st aspect-saved?) #t))
          (set-aspect! *pc-settings* mc-aspect-1000 1000)))))
  (none))

(defun mc-passthrough-activate! ((st mc-passthrough-state))
  "Minecraft takes over (or Jak was made anew, after a warp gate): remember where Jak stands,
   Minecraft puts Steve there."
  (set! (-> st jak) *target*)
  (set! (-> st spawn quad) (-> *target* control trans quad))
  (set! (-> st last-park quad) (-> *target* control trans quad))
  (set! (-> st parked?) #f)
  (set-time! (-> st handover-time))
  (set! (-> st mode) 'steve)
  (+! (-> st activations) 1)
  (format 0 "[mc-passthrough] Minecraft took over (activation ~D)~%" (-> st activations))
  (none))

(defun mc-passthrough-release! ((st mc-passthrough-state))
  "Minecraft went away: give Jak back."
  (mc-unpause! st)
  (when (-> st mode)
    (mc-set-jak-hidden! #f)
    (mc-restore-aspect! st)
    (set! *mc-passthrough-camera-pos* #f)
    (format 0 "[mc-passthrough] Minecraft disconnected, Jak is back~%"))
  (set! (-> st mode) #f)
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; fighting Jak's enemies, getting hurt, water, explosions
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun mc-state-name ((p process))
  "The name of the state p is in (or about to go to), #f if none."
  (if (-> p next-state) (-> p next-state name) (the-as symbol #f)))

(defun mc-string-has? ((s string) (part string))
  "#t if part appears in s."
  (let ((n (length s))
        (m (length part))
        (found #f))
    (dotimes (i (+ (- n m) 1))
      (when (not found)
        (let ((same #t))
          (dotimes (j m)
            (if (!= (-> s data (+ i j)) (-> part data j)) (set! same #f)))
          (if same (set! found #t)))))
    found))

(defun mc-dying-state? ((name symbol))
  "States of things that are dying or dead (nav-enemy-die, junglesnake-die, crate die...)."
  (if (not name)
    #f
    (let ((s (symbol->string name)))
      (or (mc-string-has? s "die") (mc-string-has? s "death") (mc-string-has? s "dead") (mc-string-has? s "fuel-cell")))))

(defun mc-collide-root ((p process))
  "p's collision shape, or #f. Only things with collision can be hit."
  (if (type-type? (-> p type) process-drawable)
    (let ((root (-> (the-as process-drawable p) root)))
      (if (and (nonzero? root) root (type-type? (-> root type) collide-shape))
        (the-as collide-shape root)
        (the-as collide-shape #f)))
    (the-as collide-shape #f)))

(defun mc-enemy? ((p process))
  "A living Jak enemy Steve can hurt. All of Jak's enemies (lurkers, snakes, bats, spiders, plants...)
   have the enemy process mask. Nav-enemies lose the 'attackable' mask when they die but never had it
   before, so it can't be used to find them."
  (and (logtest? (-> p mask) (process-mask enemy))
       (mc-collide-root p)
       (not (mc-dying-state? (mc-state-name p)))))

(defun mc-hittable? ((p process))
  "Things Steve's punch hits: enemies, crates (scout fly boxes too), buttons (warp gate switches), and
   the other things Jak can attack (spider eggs, dark crystals...)."
  (and (!= p *target*)
       (or (mc-enemy? p)
           (and (or (type-type? (-> p type) crate)
                    (type-type? (-> p type) basebutton)
                    (logtest? (-> p mask) (process-mask attackable)))
                (mc-collide-root p)
                (not (mc-dying-state? (mc-state-name p)))))
       #t))

;; Jak's attacks reach their target as an 'attack event that says which collision prims touched:
;; the attack handlers of Jak's enemies look at it (which part of them was hit, was it Jak's hand).
;; Steve's attacks fill in one saying Jak's hand touched all of the target.
(deftype mc-touch (structure)
  ((shapes touching-shapes-entry :inline)
   (prims  touching-prims-entry 8 :inline)))

(define *mc-touch* (new 'global 'mc-touch))
(define *mc-touch-count* 0)

(defun mc-touch-add! ((hand collide-shape-prim) (prim collide-shape-prim))
  (when (and (nonzero? prim) prim (< *mc-touch-count* 8))
    (let ((e (-> *mc-touch* prims *mc-touch-count*)))
      (set! (-> e next) (the-as touching-prims-entry #f))
      (set! (-> e prev) (the-as touching-prims-entry #f))
      (when (> *mc-touch-count* 0)
        (set! (-> e prev) (-> *mc-touch* prims (+ *mc-touch-count* -1)))
        (set! (-> *mc-touch* prims (+ *mc-touch-count* -1) next) e))
      (set! (-> e allocated?) #t)
      (set! (-> e u) 0.0)
      (set! (-> e prim1 cprim) hand)
      (set! (-> e prim1 has-tri?) #f)
      (set! (-> e prim2 cprim) prim)
      (set! (-> e prim2 has-tri?) #f)
      (+! *mc-touch-count* 1)))
  (none))

(defun mc-fake-touch ((p process))
  "A touching-shapes-entry for 'Jak's hand touches all of p', or #f if p has no collision."
  (let ((cs (mc-collide-root p)))
    (if (or (not cs) (not *target*) (zero? (-> cs root-prim)))
      (the-as touching-shapes-entry #f)
      (let ((hand (-> *target* control unknown-sphere01)) ;; prim id 64, the one Jak punches with
            (top (-> cs root-prim)))
        (set! *mc-touch-count* 0)
        (set! (-> *mc-touch* shapes cshape1) (-> *target* control))
        (set! (-> *mc-touch* shapes cshape2) cs)
        (set! (-> *mc-touch* shapes resolve-u) 0)
        (mc-touch-add! hand top)
        (when (type-type? (-> top type) collide-shape-prim-group)
          (let ((g (the-as collide-shape-prim-group top)))
            (dotimes (i (-> g num-prims))
              (mc-touch-add! hand (-> g prims i)))))
        (set! (-> *mc-touch* shapes head) (-> *mc-touch* prims 0))
        (-> *mc-touch* shapes)))))

(defun mc-send-attack! ((p process) (mode symbol))
  "Hit p the way Jak's own attacks do. 'flop breaks wooden and iron crates (scout fly boxes) and
   presses buttons, 'explode also breaks steel crates."
  (let ((msg (new 'stack-no-clear 'event-message-block)))
    (set! (-> msg from) *target*)
    (set! (-> msg num-params) 4)
    (set! (-> msg message) 'attack)
    (set! (-> msg param 0) (the-as uint (mc-fake-touch p)))
    (set! (-> msg param 1) (the-as uint mode))
    (+! *global-attack-id* 1)
    (set! (-> msg param 2) (the-as uint *global-attack-id*))
    (set! (-> msg param 3) (the-as uint 0))
    (send-event-function p msg))
  (none))

(defun mc-hit-enemy! ((p process))
  "Steve's hit kills a Jak enemy. Jak's enemies each take Jak's attacks their own way (crabs hide in
   their shell, armoured lurkers only die to red eco, bullies only to a ground pound), so Steve's hit
   tries until one works: instant death (all lurkers), an explosion, a ground pound, Jak's punch,
   Jak's spin kick. Returns #t if it worked."
  (let ((before (mc-state-name p)))
    (if (type-type? (-> p type) nav-enemy) (send-event p 'instant-death :from *target*))
    (if (= (mc-state-name p) before) (mc-send-attack! p 'explode))
    (if (= (mc-state-name p) before) (mc-send-attack! p 'flop))
    (if (= (mc-state-name p) before) (mc-send-attack! p 'punch))
    (if (= (mc-state-name p) before) (mc-send-attack! p 'spin))
    (cond
      ((= (mc-state-name p) before)
       (format 0 "[mc-passthrough] Steve hit ~A, it didn't care (~A)~%" (-> p name) before)
       #f)
      (else
       (+! (-> *mc-passthrough* kills) 1)
       (format 0 "[mc-passthrough] Steve hit ~A: ~A -> ~A~%" (-> p name) before (mc-state-name p))
       #t))))

(defun mc-steve-hit! ((p process))
  (set! (-> *mc-passthrough* punch-result) MC_PUNCH_HIT)
  (cond
    ((mc-enemy? p)
     (if (not (mc-hit-enemy! p)) (set! (-> *mc-passthrough* punch-result) MC_PUNCH_NO_EFFECT)))
    ((type-type? (-> p type) basebutton)
     (format 0 "[mc-passthrough] Steve punched button ~A~%" (-> p name))
     (mc-send-attack! p 'flop)
     ;; some buttons refuse a punch (a warp gate switch wants Geyser Rock's power cells first):
     ;; push it down anyway, Steve punched it.
     (when (and (-> p next-state) (= (-> p next-state name) 'basebutton-up-idle))
       (send-event p 'trigger)))
    (else
     (format 0 "[mc-passthrough] Steve hit ~A~%" (-> p name))
     (mc-send-attack! p 'flop)))
  (none))

(defun mc-target-sphere! ((dst vector) (p process))
  "Centre of p's collision, and its radius in w (at most 3 m: big things count from their middle)."
  (set! (-> dst quad) (-> (mc-collide-root p) root-prim prim-core world-sphere quad))
  (set! (-> dst w) (fmin (-> dst w) (meters 3.0)))
  dst)

;; search state for iterate-process-tree (GOAL lambdas can't capture locals)
(define *mc-search-origin* (new 'global 'vector))
(define *mc-search-dir* (new 'global 'vector))
(define *mc-search-reach* 0.0)
(define *mc-search-top* 0.0)
(define *mc-search-best* (the-as process #f))
(define *mc-search-best-score* 0.0)

(defun mc-steve-melee! ((st mc-passthrough-state))
  "Left click in Minecraft: hit the closest thing Steve looks at within reach (from his own eyes and
   where he looks, also in third person)."
  (set! (-> *mc-search-origin* quad) (-> st eye quad))
  (set! (-> *mc-search-dir* quad) (-> st aim quad))
  (set! *mc-search-reach* (-> st melee-reach))
  (set! *mc-search-best* #f)
  (set! *mc-search-best-score* 100000000.0)
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (when (mc-hittable? p)
        (let ((sph (mc-target-sphere! (new 'stack-no-clear 'vector) p))
              (to (new 'stack-no-clear 'vector)))
          (vector-! to sph *mc-search-origin*)
          (let* ((dist (vector-length to))
                 (along (vector-dot to *mc-search-dir*))
                 (side (sqrtf (fmax 0.0 (- (* dist dist) (* along along)))))
                 (surface (fmax 0.0 (- dist (-> sph w))))
                 ;; the closest thing, and the closer to the crosshair the better
                 (score (+ surface (* 0.5 side))))
            (when (and (< surface *mc-search-reach*)
                       (< score *mc-search-best-score*)
                       (or (< surface (meters 1.0)) ;; right next to Steve's head
                           (and (< 0.0 along)
                                (or (< side (+ (-> sph w) (meters 0.75))) ;; under the crosshair
                                    (< (* 0.75 dist) along))))) ;; within ~40 degrees of it
              (set! *mc-search-best* p)
              (set! *mc-search-best-score* score)))))
      #f)
    *kernel-context*)
  (+! (-> st punches) 1)
  (if *mc-search-best*
    (mc-steve-hit! *mc-search-best*)
    (set! (-> st punch-result) MC_PUNCH_MISSED))
  (none))

(defun mc-explode! ((x float) (y float) (z float) (radius float))
  "A Minecraft explosion (TNT, creeper...) at Jak-space x y z: kills Jak enemies and breaks crates
   in range."
  (set-vector! *mc-search-origin* x y z 1.0)
  (set! *mc-search-reach* radius)
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (when (and (mc-hittable? p) (not (type-type? (-> p type) basebutton)))
        (let ((sph (mc-target-sphere! (new 'stack-no-clear 'vector) p)))
          (when (< (- (vector-vector-distance sph *mc-search-origin*) (-> sph w)) *mc-search-reach*)
            (if (mc-enemy? p) (mc-hit-enemy! p) (mc-send-attack! p 'explode)))))
      #f)
    *kernel-context*)
  (none))

(defun mc-process-events! ((st mc-passthrough-state))
  "Handle everything Minecraft sent since last frame."
  (let ((type (pc-mc-pop-event (&-> st event 0)))
        (guard 0))
    (while (and (nonzero? type) (< guard 64))
      (when (= type MC_EVENT_EXPLOSION)
        (mc-explode! (* (-> st scale) (-> st event 0))
                     (* (-> st scale) (-> st event 1))
                     (* (-> st scale) (-> st event 2))
                     (* (-> st scale) (fmax 2.0 (-> st event 3)))))
      (+! guard 1)
      (set! type (pc-mc-pop-event (&-> st event 0)))))
  (none))

(defun mc-attack-damage ((mode symbol))
  "Minecraft health points an attack on Jak costs Steve (who has 20): Jak can take 3 hits, Steve 5.
   Pits, lava, dark eco pools and the like kill him like they kill Jak."
  (case mode
    (('deadly 'lava 'dark-eco-pool 'melt 'drown-death 'endlessfall 'death 'tar 'instant-death 'ogreboss-super-boulder) 100.0)
    (else 4.0)))

(defun mc-steve-attacked ((msg symbol) (info attack-info) (from process))
  "Hook from target-attacked: while Minecraft is playing, attacks on the hidden Jak hurt Steve.
   Returns 'hit when Steve got hurt, 'miss when he was hurt a moment ago and can't be hurt again yet
   (like Jak blinking after a hit), #f when Jak should take the attack himself."
  (let ((st *mc-passthrough*))
    (cond
      ((!= (-> st mode) 'steve) (the-as symbol #f))
      ;; enemies keep "touching" Jak while they overlap him: one hit per 0.75 s
      ((not (time-elapsed? (-> st last-hit-time) (seconds 0.75))) 'miss)
      (else
       (set-time! (-> st last-hit-time))
       (let ((mode (if (logtest? (-> info mask) (attack-mask mode)) (-> info mode) 'generic)))
         (+! (-> st steve-damage) (mc-attack-damage mode))
         (+! (-> st hits) 1)
         ;; where the hit came from: Minecraft knocks Steve away from it
         (cond
           ((and from (!= from *target*) (type-type? (-> from type) process-drawable) (nonzero? (-> (the-as process-drawable from) root)))
            (set! (-> st hit-from quad) (-> (the-as process-drawable from) root trans quad))
            (set! (-> st hit-from w) 1.0))
           (else
            ;; the ground itself (lava, pits, dark eco): no direction
            (set! (-> st hit-from w) 0.0)))
         (format 0
                 "[mc-passthrough] Steve hit by ~A (~A, ~A), total damage ~,,1f~%"
                 (if from (-> from name) "?")
                 mode
                 msg
                 (-> st steve-damage)))
       'hit))))

(defun mc-water-surface ((st mc-passthrough-state))
  "Height of the Jak water Steve is in (Jak meters), or MC_NO_WATER."
  (if (and *target* (logtest? (-> *target* water flag) (water-flag active)))
    (/ (-> *target* water base-height) (-> st scale))
    MC_NO_WATER))

(set! *mc-passthrough-attack-hook* mc-steve-attacked)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; picking things up with Steve's body
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Jak picks things up by touching them, but he is only under Steve's feet and much smaller than
;; Steve. So whatever Steve's body touches (precursor orbs, eco, power cells, scout flies, eco vents)
;; gets touched by Jak too and Jak collects it, in first or third person.
(defun mc-collect-near-steve! ((st mc-passthrough-state))
  (let ((s (/ (-> st eye-height) (meters 1.62))))
    (set! (-> *mc-search-origin* quad) (-> st feet quad))
    (set! *mc-search-reach* (* s (meters 0.9)))
    (set! *mc-search-top* (+ (-> st eye y) (meters 0.5))))
  (iterate-process-tree
    *active-pool*
    (lambda ((p process))
      (when (or (type-type? (-> p type) eco-collectable) (type-type? (-> p type) vent))
        (let ((root (-> (the-as process-drawable p) root)))
          (when (nonzero? root)
            (let ((pos (-> root trans)))
              (when (and (< (vector-vector-xz-distance pos *mc-search-origin*)
                            (if (type-type? (-> p type) vent) (+ *mc-search-reach* (meters 0.6)) *mc-search-reach*))
                         (< (- (-> *mc-search-origin* y) (meters 0.75)) (-> pos y))
                         (< (-> pos y) *mc-search-top*))
                (send-event p 'touch :from *target* (mc-fake-touch p)))))))
      #f)
    *kernel-context*)
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Minecraft blocks in Jak's world
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Minecraft sends the blocks the player built near Steve (BLOCKS packet): x, y, z (Jak meters,
;; block corner) and kind, 4 x int32 each.
(defconstant MC_MAX_BLOCKS 2048)
(defconstant MC_BLOCK_SOLID 1)
(defconstant MC_BLOCK_DEADLY 2)

(define *mc-block-data* (new 'global 'array 'int32 (* 4 MC_MAX_BLOCKS)))
(define *mc-block-count* 0)

(defun mc-refresh-blocks! ()
  (set! *mc-block-count* (pc-mc-get-blocks (the-as pointer (&-> *mc-block-data* 0)) MC_MAX_BLOCKS))
  (none))

(defun mc-block-center! ((dst vector) (i int))
  "Centre of block i, Jak units."
  (set-vector! dst
               (* METER_LENGTH (+ 0.5 (the float (-> *mc-block-data* (* i 4)))))
               (* METER_LENGTH (+ 0.5 (the float (-> *mc-block-data* (+ (* i 4) 1)))))
               (* METER_LENGTH (+ 0.5 (the float (-> *mc-block-data* (+ (* i 4) 2)))))
               1.0)
  dst)

(defun mc-nav-add-blocks ((nav nav-control))
  "Hook from nav-control-method-28 (every frame, per enemy): solid Minecraft blocks near this
   enemy, at its body height, become obstacles it has to walk around. Walls of blocks stop them.
   An enemy only has room for a few obstacles (usually 16), so the closest blocks go in first."
  (when (and (= (-> *mc-passthrough* mode) 'steve) (< 0 *mc-block-count*) (-> nav shape) (-> nav mesh))
    (let ((pos (-> nav shape trans))
          (sphere (new 'stack-no-clear 'vector))
          (inner 0.0))
      ;; three rings: 0-3 m, 3-6 m, 6-11 m (add-nav-sphere ignores anything past ~11 m anyway)
      (dotimes (ring 3)
        (let ((outer (meters (the float (case ring ((0) 3) ((1) 6) (else 11))))))
          (dotimes (i *mc-block-count*)
            (when (and (logtest? (-> *mc-block-data* (+ (* i 4) 3)) MC_BLOCK_SOLID)
                       (< (-> nav num-spheres) (-> nav max-spheres)))
              (mc-block-center! sphere i)
              (when (and (< (- (-> pos y) (meters 1.0)) (-> sphere y))
                         (< (-> sphere y) (+ (-> pos y) (meters 2.5))))
                (let ((d (vector-vector-xz-distance sphere pos)))
                  (when (and (<= inner d) (< d outer))
                    (set! (-> sphere w) (meters 0.75))
                    (add-nav-sphere nav sphere))))))
          (set! inner outer)))))
  (none))

(defun mc-deadly-blocks! ()
  "Lava, fire, magma, cactus... placed by Steve kill Jak's enemies that walk into them."
  (when (< 0 *mc-block-count*)
    (iterate-process-tree
      *active-pool*
      (lambda ((p process))
        (when (mc-enemy? p)
          (let ((epos (-> (the-as process-drawable p) root trans))
                (c (new 'stack-no-clear 'vector))
                (hit #f))
            (dotimes (i *mc-block-count*)
              (when (and (not hit) (logtest? (-> *mc-block-data* (+ (* i 4) 3)) MC_BLOCK_DEADLY))
                (mc-block-center! c i)
                (-! (-> c y) (meters 0.5)) ;; compare feet with the block's bottom
                (if (< (vector-vector-distance c epos) (meters 1.3)) (set! hit #t))))
            (if hit (mc-hit-enemy! p))))
        #f)
      *kernel-context*))
  (none))

(set! *mc-passthrough-nav-hook* mc-nav-add-blocks)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Jak's solid objects for Minecraft (crates, closed doors)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Jak's level collision only has the level itself, not its objects. Every few frames the crates
;; (scout fly boxes too) and closed doors near Steve are sent to Minecraft (ACTORS packet), which
;; puts invisible blocks there so Steve can't walk through them, and removes them when a crate
;; breaks or a door opens. 8 floats each: id, kind, x, y, z (Jak meters), half size, normal x, z.
(defconstant MC_MAX_ACTORS 64)
(defconstant MC_ACTOR_BOX 1)
(defconstant MC_ACTOR_SLAB 2)
(define *mc-actor-data* (new 'global 'array 'float (* 8 MC_MAX_ACTORS)))
(define *mc-actor-count* 0)
(define *mc-actor-timer* 0)

(defun mc-solid-actor-kind ((p process))
  "MC_ACTOR_BOX for crates, MC_ACTOR_SLAB for closed doors, 0 for everything else."
  (let ((s (if (-> p next-state) (-> p next-state name) #f)))
    (cond
      ((type-type? (-> p type) pickup-spawner) 0) ;; invisible
      ((type-type? (-> p type) crate) (if (or (= s 'die) (= s 'special-contents-die)) 0 MC_ACTOR_BOX))
      ((type-type? (-> p type) eco-door) (if (= s 'door-closed) MC_ACTOR_SLAB 0))
      (else 0))))

(defun mc-send-solid-actors! ((st mc-passthrough-state))
  "Every 6 frames: the crates and closed doors within 48 m of Steve."
  (+! *mc-actor-timer* 1)
  (when (>= *mc-actor-timer* 6)
    (set! *mc-actor-timer* 0)
    (set! *mc-actor-count* 0)
    (set! (-> *mc-search-origin* quad) (-> st pos quad))
    (iterate-process-tree
      *active-pool*
      (lambda ((p process))
        (let ((kind (mc-solid-actor-kind p)))
          (when (and (nonzero? kind) (< *mc-actor-count* MC_MAX_ACTORS))
            (let ((root (-> (the-as process-drawable p) root)))
              (when (and root (type-type? (-> root type) collide-shape))
                (let ((sph (-> (the-as collide-shape root) root-prim prim-core world-sphere))
                      (i (* 8 *mc-actor-count*))
                      (inv-m (/ 1.0 METER_LENGTH)))
                  (when (< (vector-vector-distance sph *mc-search-origin*) (meters 48.0))
                    (set! (-> *mc-actor-data* i) (the float (-> p pid)))
                    (set! (-> *mc-actor-data* (+ i 1)) (the float kind))
                    (set! (-> *mc-actor-data* (+ i 2)) (* inv-m (-> sph x)))
                    (set! (-> *mc-actor-data* (+ i 3)) (* inv-m (-> sph y)))
                    (set! (-> *mc-actor-data* (+ i 4)) (* inv-m (-> sph z)))
                    (cond
                      ((= kind MC_ACTOR_BOX)
                       ;; a crate's sphere is centred on the box and reaches its corners
                       (set! (-> *mc-actor-data* (+ i 5)) (* 0.44 inv-m (-> sph w)))
                       (set! (-> *mc-actor-data* (+ i 6)) 0.0)
                       (set! (-> *mc-actor-data* (+ i 7)) 0.0))
                      (else
                       (let ((n (-> (the-as eco-door p) out-dir)))
                         (set! (-> *mc-actor-data* (+ i 5)) (* 0.6 inv-m (-> sph w)))
                         (set! (-> *mc-actor-data* (+ i 6)) (-> n x))
                         (set! (-> *mc-actor-data* (+ i 7)) (-> n z)))))
                    (+! *mc-actor-count* 1)))))))
        #f)
      *kernel-context*)
    (pc-mc-send-actors (the-as pointer (&-> *mc-actor-data* 0)) *mc-actor-count*))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Jak's light for Minecraft
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Every other frame Minecraft gets the light Jak would be lit with where Steve stands (LIGHT
;; packet), so it can light Steve and its own blocks the same way: Jak's light group (the sun, a fill
;; light, a bounce light from below and the ambient light, blended between levels and times of day
;; by Jak's mood system; caves and buildings use their own groups), Jak's fog and his clock.
;; 32 floats: 3 x (direction xyz towards the light, color rgb x level), ambient rgb, fog rgb (0-1),
;; fog start, fog end (m), fog amount at the end (0-1), hour of the day (0-24), light group index.
(define *mc-light-data* (new 'global 'array 'float 32))
(define *mc-light-timer* 0)

(defun mc-send-light! ()
  (+! *mc-light-timer* 1)
  (when (and *target* (>= *mc-light-timer* 2))
    (set! *mc-light-timer* 0)
    (let* ((tod *time-of-day-context*)
           (idx (the int (-> *target* draw light-index)))
           (lg (-> tod light-group (if (< idx 9) idx 0)))
           (d *mc-light-data*)
           (fog (-> tod current-fog)))
      (dotimes (k 3)
        (let ((l (-> lg lights k))
              (i (* k 6)))
          (set! (-> d i) (-> l direction x))
          (set! (-> d (+ i 1)) (-> l direction y))
          (set! (-> d (+ i 2)) (-> l direction z))
          (set! (-> d (+ i 3)) (* (-> l color x) (-> l levels x)))
          (set! (-> d (+ i 4)) (* (-> l color y) (-> l levels x)))
          (set! (-> d (+ i 5)) (* (-> l color z) (-> l levels x)))))
      (set! (-> d 18) (* (-> lg ambi color x) (-> lg ambi levels x)))
      (set! (-> d 19) (* (-> lg ambi color y) (-> lg ambi levels x)))
      (set! (-> d 20) (* (-> lg ambi color z) (-> lg ambi levels x)))
      (set! (-> d 21) (/ (-> fog fog-color x) 255.0))
      (set! (-> d 22) (/ (-> fog fog-color y) 255.0))
      (set! (-> d 23) (/ (-> fog fog-color z) 255.0))
      (set! (-> d 24) (/ (-> fog fog-start) METER_LENGTH))
      (set! (-> d 25) (/ (-> fog fog-end) METER_LENGTH))
      ;; Jak's fog fades from fog-max (no fog = 255) at the start to fog-min at the end
      (set! (-> d 26) (fmax 0.0 (fmin 1.0 (/ (- (-> fog fog-max) (-> fog fog-min)) 255.0))))
      (set! (-> d 27) (-> tod time))
      (set! (-> d 28) (the float idx))
      (pc-mc-send-light (the-as pointer (&-> d 0)))))
  (none))

(defun mc-sync-pause! ((st mc-passthrough-state))
  "Minecraft's game menu pauses Minecraft: Jak pauses with it, so his world doesn't go on without
   you (enemies hitting a Steve who can't move). There's no PAUSE text: Minecraft shows its menu."
  (cond
    ((and (mc-packet-flag? st MC_FLAG_PAUSED) (= *master-mode* 'game) (not *progress-process*) (not (movie?)))
     (set! (-> st paused-jak?) #t)
     (set! *mc-passthrough-paused* #t)
     (format 0 "[mc-passthrough] Minecraft paused, pausing Jak~%")
     (set-master-mode 'pause))
    ((and (-> st paused-jak?) (not (mc-packet-flag? st MC_FLAG_PAUSED)))
     (mc-unpause! st)))
  (none))

(defun mc-unpause! ((st mc-passthrough-state))
  "Undo mc-sync-pause!."
  (when (-> st paused-jak?)
    (set! (-> st paused-jak?) #f)
    (set! *mc-passthrough-paused* #f)
    (when (= *master-mode* 'pause)
      (format 0 "[mc-passthrough] Minecraft unpaused, Jak goes on~%")
      (set-master-mode 'game)))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; every frame (called from update-camera)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun mc-passthrough-poll ()
  "Fetch the newest Minecraft packet. Returns #t if Minecraft is playing this frame."
  (let ((st *mc-passthrough*))
    (cond
      ((not (-> st enabled?)) (mc-passthrough-release! st))
      ((not (mc-packet-fresh? st)) (mc-passthrough-release! st))
      ;; no Jak right now (title screen, or the moment between a warp gate and the next level,
      ;; when the game makes a new Jak): stay in charge and wait for him
      ((not *target*) #f)
      ((not (-> st mode)) (mc-passthrough-activate! st))
      ;; a new Jak (warp gate, new game): start over from where he is
      ((!= (-> st jak) *target*) (mc-passthrough-activate! st)))
    (if (-> st mode) #t #f)))

(defun mc-passthrough-compute-pose! ((st mc-passthrough-state))
  "Steve's eyes and look direction in Jak space."
  ;; Steve's size (Minecraft can make him taller): eye height, and a longer reach with it
  (let ((eye (-> st raw MC_RAW_EYE_HEIGHT)))
    (set! (-> st eye-height) (meters (if (and (< 0.5 eye) (< eye 6.0)) eye 1.62)))
    (set! (-> st melee-reach) (* (meters 4.5) (/ (-> st eye-height) (meters 1.62)))))
  (let* ((heading (- (degrees (-> st raw MC_RAW_YAW))))
         ;; clamp so forward is never parallel to down (forward-down->inv-matrix would divide by 0)
         (pitch (degrees (fmax -89.5 (fmin 89.5 (-> st raw MC_RAW_PITCH)))))
         (cp (cos pitch))
         (sp (sin pitch)))
    (set-vector! (-> st pos)
                 (* (-> st scale) (-> st raw MC_RAW_X))
                 (* (-> st scale) (-> st raw MC_RAW_Y))
                 (* (-> st scale) (-> st raw MC_RAW_Z))
                 1.0)
    ;; Minecraft pitch is positive looking down, Jak +Y is up.
    (set-vector! (-> st fwd) (* (sin heading) cp) (- sp) (* (cos heading) cp) 0.0))
  ;; where Steve himself looks: the same as the camera, except in Minecraft's front view
  (cond
    ((< 0.5 (-> st raw MC_RAW_HAS_LOOK))
     (let* ((heading (- (degrees (-> st raw MC_RAW_LOOK_YAW))))
            (pitch (degrees (fmax -90.0 (fmin 90.0 (-> st raw MC_RAW_LOOK_PITCH)))))
            (cp (cos pitch)))
       (set-vector! (-> st aim) (* (sin heading) cp) (- (sin pitch)) (* (cos heading) cp) 0.0)))
    (else (set! (-> st aim quad) (-> st fwd quad))))
  ;; Steve's body: sent separately, since in third person the camera is behind him
  (cond
    ((< 0.5 (-> st raw MC_RAW_HAS_FEET))
     (set-vector! (-> st feet)
                  (* (-> st scale) (-> st raw MC_RAW_FEET_X))
                  (* (-> st scale) (-> st raw MC_RAW_FEET_Y))
                  (* (-> st scale) (-> st raw MC_RAW_FEET_Z))
                  1.0))
    (else
     (set! (-> st feet quad) (-> st pos quad))
     (-! (-> st feet y) (-> st eye-height))))
  (set! (-> st eye quad) (-> st feet quad))
  (+! (-> st eye y) (-> st eye-height))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; level streaming around Steve
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Jak 1 can only hold 2 levels at a time (two fixed memory heaps, and the renderer has draw
;; buckets for exactly 2 levels). Its load boundaries switch them along the paths Jak can take.
;; Steve can fly anywhere, so twice a second the 2 levels closest to Steve's camera are found, and
;; if the one he is in hasn't been shown for a second, those 2 are loaded and shown.
(define *mc-stream-timer* 0)
(define *mc-stream-misses* 0)
(define *mc-stream-last* (the-as symbol #f))

(defun mc-stream-level? ((info level-load-info))
  "Levels that are part of the world (not the title screen, intro, demo, test levels)."
  (and (< 0.0 (-> info bsphere w))
       (< (-> info bsphere w) (meters 5000.0))
       (!= (-> info name) 'title)))

(defun mc-level-in-memory? ((name symbol))
  "#t if that level is loading, loaded or showing."
  (let ((s (level-status *level* name)))
    (or (= s 'active) (= s 'loaded) (= s 'loading) (= s 'loading-bt) (= s 'login))))

(defun mc-level-showing? ((name symbol))
  "#t if that level is loaded and being drawn."
  (let ((lev (level-get *level* name)))
    (and lev (= (-> lev status) 'active) (-> lev display?))))

(defun mc-stream-levels! ((st mc-passthrough-state))
  (+! *mc-stream-timer* 1)
  (when (>= *mc-stream-timer* 15) ;; 4 times a second
    (set! *mc-stream-timer* 0)
    (let ((best (the-as level-load-info #f))
          (best-score 1000000.0)
          (second (the-as level-load-info #f))
          (second-score 100000000.0)
          (rest *level-load-list*))
      ;; the level Steve is in: the one whose bounding sphere he is deepest inside (relative to
      ;; its size, so a small level inside a big one wins)
      (while (not (null? rest))
        (let ((info (the-as level-load-info (-> (the-as symbol (car rest)) value))))
          (when (and info (mc-stream-level? info))
            (let ((score (/ (vector-vector-distance (-> st pos) (-> info bsphere)) (-> info bsphere w))))
              (when (< score best-score)
                (set! best info)
                (set! best-score score)))))
        (set! rest (cdr rest)))
      ;; its neighbour: the other level whose edge is closest. One that is already in memory wins
      ;; unless another is a lot closer, so flying around doesn't keep throwing levels away half
      ;; loaded.
      (set! rest *level-load-list*)
      (while (not (null? rest))
        (let ((info (the-as level-load-info (-> (the-as symbol (car rest)) value))))
          (when (and info (!= info best) (mc-stream-level? info))
            (let ((edge (- (vector-vector-distance (-> st pos) (-> info bsphere)) (-> info bsphere w))))
              (if (mc-level-in-memory? (-> info name)) (set! edge (- edge (meters 150.0))))
              (when (< edge second-score)
                (set! second info)
                (set! second-score edge)))))
        (set! rest (cdr rest)))
      (when best
        (set! (-> st stream-want) (-> best index))
        (if (mc-level-showing? (-> best name))
          (set! *mc-stream-misses* 0)
          (+! *mc-stream-misses* 1))
        ;; not showing for ~0.75 s: ask for it (asking again while it loads changes nothing)
        (when (>= *mc-stream-misses* 3)
          (set! *mc-stream-misses* 0)
          (let ((a (-> best name))
                (b (if second (-> second name) (the-as symbol #f))))
            (when (!= a *mc-stream-last*)
              (format 0 "[mc-passthrough] loading ~A and ~A around Steve~%" a b))
            (set! *mc-stream-last* a)
            (load-state-want-levels a b)
            (load-state-want-display-level a 'display)
            (if b (load-state-want-display-level b 'display))
            (load-state-want-vis (-> best nickname)))))))
  (none))

;; Jak isn't drawn (skip-bones), and the renderer counts down an object's death / warp effect
;; timer only while it draws it. The game waits for the 'death-end at the end of that timer
;; (a warp gate loads the next level once Jak has vanished into it), so count it down here.
(defun mc-jak-effect-timer! ()
  (let ((dc (-> *target* draw)))
    (when (and (logtest? (-> dc status) (draw-status skip-bones)) (nonzero? (-> dc death-timer)) (not (paused?)))
      (set! (-> dc death-timer) (+ (-> dc death-timer) -1))
      (if (>= 1 (-> dc death-timer)) (send-event *target* 'death-end dc))))
  (none))

;; Jak states in which the game itself is using Jak (talking to someone, power cell dance, warp
;; gate, launcher, dying / respawning, cutscene animations)
(defun mc-jak-busy? ()
  "#t while the game itself is using Jak: leave him alone then."
  (cond
    ((movie?) #t)
    ((logtest? (-> *target* state-flags) (state-flags grabbed dying)) #t)
    ((not (-> *target* next-state)) #f)
    (else
     (let ((s (-> *target* next-state name)))
       (if (or (= s 'target-warp-out)
               (= s 'target-warp-in)
               (= s 'target-launch)
               (= s 'target-clone-anim)
               (= s 'target-play-anim)
               (= s 'target-death)
               (= s 'target-continue)
               (= s 'target-grab)
               (= s 'target-final-door))
         #t
         #f)))))

(defun mc-passthrough-handover! ((st mc-passthrough-state))
  "The game moved Jak somewhere by itself (warp gate, checkpoint, launcher, cutscene): Minecraft
   puts Steve there (a new activation id makes it teleport him once)."
  (set! (-> st spawn quad) (-> *target* control trans quad))
  (set! (-> st last-park quad) (-> *target* control trans quad))
  (set! (-> st parked?) #f)
  (set-time! (-> st handover-time))
  (+! (-> st activations) 1)
  (+! (-> st handovers) 1)
  (format 0 "[mc-passthrough] the game moved Jak, sending Steve after him (~D)~%" (-> st handovers))
  (none))

(defun mc-snap-jak! ((st mc-passthrough-state))
  "Put Jak exactly on Steve's feet, standing still."
  (move-to-point! (-> *target* control) (-> st feet))
  (set! (-> *target* control transv quad) (the-as uint128 0))
  (set! (-> st last-park quad) (-> st feet quad))
  (none))

(defun mc-passthrough-park-jak! ((st mc-passthrough-state))
  "Jak is hidden and dragged along under Steve's feet, so levels, actors and pickups keep streaming
   around Steve and Jak's world reacts to him. His controller is cut off (mc-passthrough-pad!)."
  (when *target*
    (mc-set-jak-hidden! #t)
    (mc-jak-effect-timer!)
    (let ((feet (-> st feet)))
      (cond
        ((mc-jak-busy?) #f)
        ;; Steve dug into Jak's ground: Jak can't follow him under his own floor, he waits on top
        ((mc-packet-flag? st MC_FLAG_IN_HOLE) #f)
        ((< (meters 8.0) (vector-vector-distance (-> *target* control trans) (-> st last-park)))
         (mc-passthrough-handover! st))
        (else
         ;; after (re)activation Minecraft teleports Steve to the spawn point a moment later: don't
         ;; drag Jak back to wherever Steve was before that. After 3 s Jak follows Steve wherever
         ;; he is (Jak must be with Steve, or the levels around Steve don't load).
         (if (or (< (vector-vector-distance feet (-> st spawn)) (meters 3.0))
                 (time-elapsed? (-> st handover-time) (seconds 3)))
           (set! (-> st parked?) #t))
         (when (-> st parked?)
           ;; how far Jak got from Steve since the start of the frame (shown by /jakcraft)
           (set! (-> st jak-gap) (/ (vector-vector-distance (-> *target* control trans) feet) METER_LENGTH))
           (mc-snap-jak! st))))))
  (none))

(defun mc-passthrough-gameplay! ((st mc-passthrough-state))
  "Everything Minecraft does to Jak's world this frame."
  (mc-sync-aspect! st)
  (mc-send-light!)
  ;; not while Jak is paused (Minecraft's menu, Jak's own menu)
  (when (and (= *master-mode* 'game) (not *progress-process*))
    (mc-process-events! st)
    (mc-refresh-blocks!)
    (mc-deadly-blocks!)
    (mc-send-solid-actors! st)
    (mc-stream-levels! st)
    (mc-collect-near-steve! st)
    (let ((buttons (the int (-> st raw MC_RAW_BUTTONS))))
      ;; punch on click, and keep punching every 0.35 s while held
      (when (and (logtest? buttons MC_BUTTON_ATTACK)
                 (or (not (logtest? (-> st prev-buttons) MC_BUTTON_ATTACK))
                     (time-elapsed? (-> st last-attack-time) (seconds 0.35))))
        (set-time! (-> st last-attack-time))
        (mc-steve-melee! st))
      (set! (-> st prev-buttons) buttons)))
  (none))

(defun mc-level-code ((lev level))
  "A level slot for JAK_STATE: 0 empty, 1 loading, 2 loaded, 3 active; +4 if it is being drawn."
  (let ((s (-> lev status)))
    (+ (cond
         ((or (= s 'loading) (= s 'loading-bt) (= s 'login)) 1)
         ((= s 'loaded) 2)
         ((= s 'active) 3)
         (else 0))
       (if (and (!= s 'inactive) (-> lev display?)) 4 0))))

(defun mc-passthrough-report! ((st mc-passthrough-state) (flags int))
  "Jak -> Minecraft state (see JAK_STATE in PROTOCOL.md)."
  (let ((inv-s (/ 1.0 (-> st scale))))
    (set! (-> st out 0) (* inv-s (-> st spawn x)))
    (set! (-> st out 1) (* inv-s (-> st spawn y)))
    (set! (-> st out 2) (* inv-s (-> st spawn z))))
  (set! (-> st out 3) (-> st steve-damage))
  (set! (-> st out 4) (if *target* (-> *target* fact health) 0.0))
  (set! (-> st out 5) (the float flags))
  (set! (-> st out 6) (the float (-> st activations)))
  (set! (-> st out 7) (mc-water-surface st))
  ;; where the last thing that hurt Steve was (Jak meters), so he is knocked away from it
  (let ((inv-s (/ 1.0 (-> st scale))))
    (cond
      ((< 0.5 (-> st hit-from w))
       (set! (-> st out 8) (* inv-s (-> st hit-from x)))
       (set! (-> st out 9) (* inv-s (-> st hit-from y)))
       (set! (-> st out 10) (* inv-s (-> st hit-from z))))
      (else
       (set! (-> st out 8) MC_NO_WATER)
       (set! (-> st out 9) MC_NO_WATER)
       (set! (-> st out 10) MC_NO_WATER))))
  ;; how well Jak keeps up with Steve, what Steve's punches do, which levels are loaded
  (set! (-> st out 11) (-> st jak-gap))
  (set! (-> st out 12) (if (-> st parked?) 1.0 0.0))
  (set! (-> st out 13) (the float (-> st kills)))
  (set! (-> st out 14) (the float (-> st punches)))
  (set! (-> st out 15) (the float (-> st punch-result)))
  (dotimes (i 2)
    (let ((lev (-> *level* level i)))
      (set! (-> st out (+ 16 (* 2 i)))
            (if (and (!= (-> lev status) 'inactive) (-> lev info)) (the float (-> lev info index)) 0.0))
      (set! (-> st out (+ 17 (* 2 i))) (the float (mc-level-code lev)))))
  (set! (-> st out 20) (the float (-> st stream-want)))
  (set! (-> st out 21) 0.0)
  (pc-mc-send-state (&-> st out 0))
  (none))

(defun mc-passthrough-apply! ((mcam math-camera))
  "Put Jak's camera at Steve's eyes, run the Minecraft-side gameplay and report back."
  (let ((st *mc-passthrough*))
    (mc-passthrough-compute-pose! st)
    (set! (-> mcam trans quad) (-> st pos quad))
    (forward-down->inv-matrix (-> mcam inv-camera-rot) (-> st fwd) (new 'static 'vector :y -1.0))
    ;; Jak's fov is horizontal and its y-ratio depends on aspect/vis settings. Instead of
    ;; special-casing those, measure k = y-ratio / tan(fov/2) from the current camera and solve for
    ;; the fov that gives Minecraft's vertical fov.
    (when (and (-> st match-fov?) (< 1.0 (-> st raw MC_RAW_VFOV)) (< 0.0 (-> mcam fov)))
      (let ((k (/ (-> mcam y-ratio) (tan (* 0.5 (-> mcam fov))))))
        (when (< 0.0 k)
          (set! (-> mcam fov) (* 2.0 (atan (/ (tan (* 0.5 (degrees (-> st raw MC_RAW_VFOV)))) k) 1.0)))
          ;; recompute ratios now so the new fov applies this frame instead of next frame.
          (update-math-camera mcam (-> *setting-control* current video-mode) (-> *setting-control* current aspect-ratio)))))
    ;; never blend toward a stale Jak orientation while Minecraft is driving.
    (set! (-> mcam smooth-t) 0.0)
    ;; this frame is drawn from the pose Minecraft sent: tag it so Minecraft can match it exactly
    (pc-mc-pose-used)
    ;; and level loading must see the camera where it really is
    (set! *mc-passthrough-camera-pos* (-> st pos))
    (mc-passthrough-park-jak! st)
    (mc-passthrough-gameplay! st)
    (mc-passthrough-report! st JAK_STATE_FLAG_STEVE)
    (when (-> st debug?)
      ;; GOAL calls are limited to 8 arguments, so this is split up.
      (format *stdcon* "mc seq ~D age ~,,1fms fov ~,,1f blocks ~D~%" (the int (-> st raw MC_RAW_SEQ)) (-> st raw MC_RAW_AGE_MS) (-> st raw MC_RAW_VFOV) *mc-block-count*)
      (format *stdcon*
              "mc ~,,2f ~,,2f ~,,2f yaw ~,,1f pitch ~,,1f~%"
              (-> st raw MC_RAW_X) (-> st raw MC_RAW_Y) (-> st raw MC_RAW_Z)
              (-> st raw MC_RAW_YAW) (-> st raw MC_RAW_PITCH))
      (format *stdcon* "cam ~,,2M ~,,2M ~,,2M~%" (-> st pos x) (-> st pos y) (-> st pos z))))
  (none))

(defun mc-jak-away? ((st mc-passthrough-state))
  "#t while the game has taken Jak far from Steve by itself (warp gate, respawn, launcher) and
   until Minecraft has brought Steve there. Jak's own camera follows him meanwhile, so Jak's world
   loads around Jak, not around where Steve was."
  (let ((feet (-> st feet)))
    (if (and (< (meters 12.0) (vector-vector-distance (-> *target* control trans) feet))
             (or (mc-jak-busy?)
                 (and (not (-> st parked?)) (not (time-elapsed? (-> st handover-time) (seconds 3))))))
      #t
      #f)))

(defun mc-passthrough-camera! ((mcam math-camera))
  "Hook called from update-camera. Returns #t if Minecraft drove the camera this frame."
  (let ((st *mc-passthrough*)
        (jak-camera (logior JAK_STATE_FLAG_STEVE JAK_STATE_FLAG_CUTSCENE)))
    ;; Jak's camera unless mc-passthrough-apply! below says otherwise
    (set! *mc-passthrough-camera-pos* #f)
    (cond
      ((not (mc-passthrough-poll)) #f)
      ((not *target*)
       ;; between levels: Jak's own camera (loading, warp effect); Minecraft shows it full screen
       (mc-passthrough-report! st jak-camera)
       #f)
      (else
       (mc-passthrough-compute-pose! st)
       (mc-sync-pause! st)
       (cond
         ((movie?)
          ;; cutscene: it plays with Jak's own camera and Jak in it (shown once, the cutscene may
          ;; hide him itself); Minecraft shows it full screen
          (when (not (-> st in-movie?))
            (set! (-> st in-movie?) #t)
            (mc-set-jak-hidden! #f))
          (mc-sync-aspect! st)
          (mc-passthrough-report! st jak-camera)
          #f)
         ((mc-jak-away? st)
          (set! (-> st in-movie?) #f)
          (mc-passthrough-park-jak! st) ;; keeps him hidden, sends Steve after him once he lands
          (mc-sync-aspect! st)
          (mc-passthrough-report! st jak-camera)
          #f)
         (else
          (set! (-> st in-movie?) #f)
          (mc-passthrough-apply! mcam)
          #t))))))

(set! *mc-passthrough-camera-hook* mc-passthrough-camera!)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Jak's controller (called from service-cpads)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun mc-buttons->pad ((b int))
  "Minecraft's Jak keys -> Jak buttons."
  (let ((out 0))
    (if (logtest? b MC_BUTTON_JAK_CIRCLE) (set! out (logior out (pad-buttons circle))))
    (if (logtest? b MC_BUTTON_JAK_X) (set! out (logior out (pad-buttons x))))
    (if (logtest? b MC_BUTTON_JAK_TRIANGLE) (set! out (logior out (pad-buttons triangle))))
    (if (logtest? b MC_BUTTON_JAK_LEFT) (set! out (logior out (pad-buttons left))))
    (if (logtest? b MC_BUTTON_JAK_RIGHT) (set! out (logior out (pad-buttons right))))
    (if (logtest? b MC_BUTTON_JAK_UP) (set! out (logior out (pad-buttons up))))
    (if (logtest? b MC_BUTTON_JAK_DOWN) (set! out (logior out (pad-buttons down))))
    out))

(defun mc-jak-on-steve? ((st mc-passthrough-state))
  "#t when Jak is meant to be on Steve's feet right now (not while the game is using him, not
   while Steve is down a hole, not just after the game moved him somewhere)."
  (and (= (-> st mode) 'steve)
       (-> st parked?)
       *target*
       (= (-> st jak) *target*)
       (not (mc-packet-flag? st MC_FLAG_IN_HOLE))
       (not (mc-jak-busy?))))

(defun mc-passthrough-early-snap! ((st mc-passthrough-state))
  "Start of the frame, before Jak and his world run: put Jak where Steve is right now (the newest
   Minecraft packet), so this frame's enemies, pickups, triggers and level loading all see Jak
   exactly where Steve is instead of where he was last frame. update-camera puts him there again
   at the end of the frame."
  (when (and (mc-packet-fresh? st) (mc-jak-on-steve? st))
    (mc-passthrough-compute-pose! st)
    ;; something moved Jak far since the end of last frame: leave that to mc-passthrough-park-jak!
    (when (< (vector-vector-distance (-> *target* control trans) (-> st last-park)) (meters 8.0))
      (mc-snap-jak! st)))
  (none))

(defun mc-jak-punch-buttons ((st mc-passthrough-state))
  "Steve's left click makes the hidden Jak punch too (Minecraft's jak_punch setting), turned the
   way Steve looks: Jak's own punch, from Steve's feet, hits what Jak's fist reaches. Returns the
   square button on the frame the click starts, 0 otherwise."
  (let ((buttons (the int (-> st raw MC_RAW_BUTTONS)))
        (out 0))
    (when (and (logtest? buttons MC_BUTTON_ATTACK)
               (not (logtest? (-> st pad-prev-buttons) MC_BUTTON_ATTACK))
               (mc-packet-flag? st MC_FLAG_JAK_PUNCH)
               (mc-jak-on-steve? st))
      (let ((dir (new 'stack-no-clear 'vector)))
        (set-vector! dir (-> st aim x) 0.0 (-> st aim z) 0.0)
        (when (< 0.01 (vector-length dir))
          (vector-normalize! dir 1.0)
          (set-heading-vec! (-> *target* control) dir)
          (rot->dir-targ! (-> *target* control))))
      (set! out (the int (pad-buttons square))))
    (set! (-> st pad-prev-buttons) buttons)
    out))

(defun mc-passthrough-pad! ((pad cpad-info))
  "Controller 0, every frame. While Minecraft is playing, Jak doesn't walk, jump or attack by
   himself: only START / SELECT (Jak's pause menu, to save) and Minecraft's Jak keys get through.
   This runs at the start of each frame, so Jak is also put on Steve's feet here."
  (let ((st *mc-passthrough*))
    (when (and (= (-> st mode) 'steve) (= *master-mode* 'game) (not *progress-process*))
      (mc-passthrough-early-snap! st)
      (let ((keep (logand (-> pad button0) (pad-buttons start select)))
            (jak-keys (logior (mc-buttons->pad (the int (-> st raw MC_RAW_BUTTONS))) (mc-jak-punch-buttons st))))
        ;; look like a connected dualshock with centred sticks
        (set! (-> pad valid) (the-as uint 0))
        (set! (-> pad status) (the-as uint #x73))
        (set! (-> pad button0) (the-as uint (logior keep jak-keys)))
        (set! (-> pad leftx) (the-as uint 128))
        (set! (-> pad lefty) (the-as uint 128))
        (set! (-> pad rightx) (the-as uint 128))
        (set! (-> pad righty) (the-as uint 128)))))
  (none))

(set! *mc-passthrough-pad-hook* mc-passthrough-pad!)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; REPL helpers
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun mc-on ()
  "Let Minecraft take over whenever it is connected."
  (set! (-> *mc-passthrough* enabled?) #t)
  (none))

(defun mc-off ()
  "Give everything back to Jak, ignoring Minecraft."
  (set! (-> *mc-passthrough* enabled?) #f)
  (mc-passthrough-release! *mc-passthrough*)
  (none))

(defun mc-reanchor ()
  "Start over: Jak's current position becomes the spawn point Minecraft puts Steve on."
  (mc-passthrough-release! *mc-passthrough*)
  (none))

(defun mc-debug ((on symbol))
  "Toggle the on-screen status text."
  (set! (-> *mc-passthrough* debug?) on)
  (none))

(defun mc-status ()
  "Print the bridge status to the REPL."
  (let ((st *mc-passthrough*))
    (pc-mc-get-camera (&-> st raw 0))
    (format #t "enabled ~A mode ~A activations ~D handovers ~D blocks ~D~%" (-> st enabled?) (-> st mode) (-> st activations) (-> st handovers) *mc-block-count*)
    (format #t "Steve: hurt ~D times (~,,1f health), killed ~D~%" (-> st hits) (-> st steve-damage) (-> st kills))
    (format #t "last packet: seq ~D age ~,,1fms vfov ~,,1f flags ~D~%" (the int (-> st raw MC_RAW_SEQ)) (-> st raw MC_RAW_AGE_MS) (-> st raw MC_RAW_VFOV) (the int (-> st raw MC_RAW_FLAGS)))
    (format #t
            "mc pos ~,,2f ~,,2f ~,,2f yaw ~,,1f pitch ~,,1f~%"
            (-> st raw MC_RAW_X) (-> st raw MC_RAW_Y) (-> st raw MC_RAW_Z)
            (-> st raw MC_RAW_YAW) (-> st raw MC_RAW_PITCH)))
  (none))
